# Unity: carpetas generadas, nunca contenido fuente ni archivos .meta.
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Archivos generados por IDE y herramientas de compilación.
/.vs/
/.idea/
/.gradle/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Temporales del sistema y volcados de errores.
.DS_Store
Thumbs.db
sysinfo.txt
*.stackdump
crashlytics-build.properties

# Cache y copias de seguridad del proceso de arte.
/Assets/Party/Art/BlenderScripts/__pycache__/
/Assets/Party/Art/BlenderScripts/__pycache__.meta
/Assets/Party/Art/BlenderSources~/*.blend1

# La ciudad vigente y sus GUID se respaldan completos. Otros intentos siguen siendo temporales.
/Assets/Party/Generated/*
!/Assets/Party/Generated/Ciudad2km/
!/Assets/Party/Generated/Ciudad2km.meta
/Assets/Party/Scenes/Backups/
/Assets/Party/Scenes/Backups.meta

# Cachés, compilados y registros de los scripts de Blender y pruebas: se regeneran al ejecutarlos.
__pycache__/
*.pyc
*.blend1
/Assets/Party/Art/BlenderScripts/**/bin/
/Assets/Party/Art/BlenderScripts/**/obj/
/Assets/Party/Art/BlenderScripts/**/*.log

# Esta fuente supera 100 MiB. Su ZIP íntegro se versiona junto con el manifiesto SHA-256.
# Restore-Project.ps1 la recupera sin modificar una copia local existente.
/Assets/Party/Art/BlenderSources~/Villa_Alarma_R9_Ligera.blend
/Assets/Party/Art/BlenderSources~/Villa_Alarma_R9_Ligera.blend.zip
/Assets/Party/Art/BlenderSources~/*.tmp

# BEGIN current-city-backup
/Assets/Party/Generated/Ciudad2km/Revisiones/*
!/Assets/Party/Generated/Ciudad2km/Revisiones/R_4a1a5f3a17274e5b92ef6cbad45bf47c/
!/Assets/Party/Generated/Ciudad2km/Revisiones/R_4a1a5f3a17274e5b92ef6cbad45bf47c.meta
# END current-city-backup
